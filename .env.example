# ---- App ----
NEXT_PUBLIC_APP_NAME="AI Interview Coach"      # the ONLY public variable
AUTH_SECRET=                                   # 32+ random bytes, e.g. `openssl rand -base64 32`
APP_BASE_URL=http://localhost:3000

# ---- AI provider switch ----
AI_PROVIDER=mock                               # mock | azure (Phases 3-5 only) | functions (Phase 6+)

# ---- Azure OpenAI / AI Foundry (used by AI_PROVIDER=azure, and by the Function App in Phase 6+) ----
AZURE_OPENAI_ENDPOINT=                         # https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=                      # use the version shown in the portal/docs for your deployment
AZURE_OPENAI_DEPLOYMENT=                       # the DEPLOYMENT NAME you chose, not the model name

# ---- Azure SQL ----
AZURE_SQL_SERVER=                              # <server>.database.windows.net
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# ---- Azure Blob Storage ----
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=resumes
MAX_RESUME_SIZE_MB=5

# ---- Azure Functions (Phase 6+) ----
AZURE_FUNCTIONS_BASE_URL=http://localhost:7071 # production: https://<function-app>.azurewebsites.net
AZURE_FUNCTIONS_KEY=                           # function key (host key for local can be empty)

# ---- Monitoring (Phase 8) ----
APPLICATIONINSIGHTS_CONNECTION_STRING=
